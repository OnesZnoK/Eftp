{
  "version": 3,
  "configurePresets": [
    {
      "hidden": true,
      "name": "Qt-Base",
      "generator": "Ninja",
      "architecture": {
        "strategy": "external",
        "value": "x86"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "C:/Qt/Qt5.12.12/5.12.12/msvc2017"
      }
    },
    {
      "name": "Qt-Debug",
      "inherits": "Qt-Base",
      "displayName": "Qt Debug (x86)",
      "binaryDir": "${sourceDir}/out/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Qt-Release",
      "inherits": "Qt-Base",
      "displayName": "Qt Release (x86)",
      "binaryDir": "${sourceDir}/out/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ]
}
