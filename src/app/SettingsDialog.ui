      </item>
      <item>
       <widget class="QTableWidget" name="tableRouteWifi">
        <property name="columnCount"><number>3</number></property>
        <column><property name="text"><string>工序ID</string></property></column>
        <column><property name="text"><string>SSID</string></property></column>
        <column><property name="text"><string>密码</string></property></column>
