   <!-- WiFi 配置（可编辑） -->
   <item>
    <widget class="QGroupBox" name="groupWifi">
     <property name="title"><string>WiFi 配置</string></property>
     <layout class="QVBoxLayout" name="wifiLayout">
      <item>
       <widget class="QLabel" name="labelDefaultWifiTitle">
        <property name="text"><string>默认WiFi：</string></property>
        <property name="styleSheet"><string notr="true">font-weight:bold;</string></property>
